NEXT_PUBLIC_SUPABASE_URL=https://xzlfrpamifzpexfajdlg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Google Search Console HTML verification token (value only, without the meta tag wrapper)
GOOGLE_SITE_VERIFICATION=replace_with_google_search_console_token

# REQUIRED: real2free is the APIPlayer reference/test client.
# Catalog detail and playback must use the same Customer API/wrapper path as client sites.
# There is intentionally no legacy playback fallback when these credentials are missing or invalid.
APIPLAYER_API_URL=https://www.apiplayer.online
APIPLAYER_API_KEY=replace_with_real2free_customer_api_key
APIPLAYER_CLIENT_DOMAIN=real2free.online

# OPTIONAL: multi-client diagnostics in /admin/apiplayer-reference-test.
# Additional domains appear as simulator presets. The built-in presets already include
# real2free.online, doodee.online, nung24.online and xn--l3caa5kbu.online.
APIPLAYER_TEST_CLIENT_DOMAINS=
# Optional server-only JSON map for true customer credential simulation.
# Never expose this variable with NEXT_PUBLIC_. If a domain is not present here,
# the simulator intentionally uses APIPLAYER_API_KEY and labels the result REFERENCE KEY.
# Example: {"doodee.online":"customer_key_here","nung24.online":"customer_key_here"}
APIPLAYER_TEST_CLIENT_KEYS_JSON=
